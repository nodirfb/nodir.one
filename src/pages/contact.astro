---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact — Nodir Fayzullayev"
  description="Contact Nodir Fayzullayev, a data analyst in Tashkent."
  path="/contact/"
>
  <header class="intro">
    <p class="label">Contact</p>
    <h1 class="claim">Let&rsquo;s talk about data systems and operational analytics.</h1>
    <p class="prose lead">
      For work, collaboration, or a practical data problem, email is the best place to start.
    </p>
  </header>

  <ul class="contact">
    <li><b>Email</b><span><a href="mailto:nodirfayz18@gmail.com">nodirfayz18@gmail.com</a></span></li>
    <li><b>LinkedIn</b><span><a href="https://www.linkedin.com/in/nodirf/" rel="me">linkedin.com/in/nodirf</a></span></li>
    <li><b>GitHub</b><span><a href="https://github.com/nodirfb" rel="me">github.com/nodirfb</a></span></li>
    <li><b>Telegram</b><span><a href="https://t.me/nodirfayzullayev" rel="me">@nodirfayzullayev</a></span></li>
  </ul>
</Base>

<style>
  .intro .label { margin-bottom: 0.9rem; }
  .intro .claim { margin-bottom: 1.15rem; }
  .lead { font-size: var(--t-summary); }
  .contact {
    --contact-label: 10ch;
    list-style: none;
    margin: var(--gap-section) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .contact li {
    display: grid;
    grid-template-columns: var(--contact-label) minmax(0, 1fr);
    align-items: center;
    font-family: var(--mono);
    font-size: var(--t-layer);
    line-height: 1.55;
  }
  .contact b {
    color: var(--slate);
    font-size: var(--t-label);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .contact a {
    display: inline-block;
    overflow-wrap: anywhere;
    padding-block: 0.32rem;
  }
</style>
