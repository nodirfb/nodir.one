---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Staircase from '../components/Staircase.astro';
import heroWide from '../assets/hero-wide.jpg';
import heroTall from '../assets/hero-tall.jpg';
import clearance from '../data/photo-clearance.json';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/* Both hero files are already exactly their delivery size — variant A caps the
   render at 1x, and that cap is what keeps the wall display illegible. So there
   is one srcset candidate per crop and nothing is ever upscaled. */
const set = async (src: ImageMetadata, format: 'avif' | 'webp', widths: number[]) =>
  (
    await Promise.all(
      widths
        .filter((w) => w <= src.width)
        .map(async (w) => `${(await getImage({ src, format, width: w, quality: 70 })).src} ${w}w`),
    )
  ).join(', ');

const WIDE = [704, 1408, 2112];
const TALL = [328, 656, 984, 1312];
const wideAvif = await set(heroWide, 'avif', WIDE);
const wideWebp = await set(heroWide, 'webp', WIDE);
const tallAvif = await set(heroTall, 'avif', TALL);
const tallWebp = await set(heroTall, 'webp', TALL);
const fallback = await getImage({ src: heroTall, format: 'jpeg', width: 656 });

/* sizes must be present on every source: without it the browser assumes 100vw and
   pulls the largest candidate for a 704px box. */
const WIDE_SIZES = '704px';
const TALL_SIZES = 'calc(100vw - 2 * clamp(1rem, 4vw, 2rem))';

const alt =
  'Nodir Fayzullayev in the Pentazone operations room, in front of the wall-mounted ' +
  'display that runs the branch reporting he built.';

const title = 'Nodir Fayzullayev — Data Analyst in Tashkent';
const description =
  'Data analyst building the full operational data chain: 1C extraction, SQL Server models, Power BI, Python automation, and internal tools.';
---

<Base title={title} description={description} path="/">
  {/* ---- Opening -------------------------------------------------------- */}
  <section class="opening">
    {
      clearance.variant !== 'C' && (
        <figure class="hero">
          <picture>
            <source media="(min-width: 900px)" type="image/avif" srcset={wideAvif} sizes={WIDE_SIZES} />
            <source media="(min-width: 900px)" type="image/webp" srcset={wideWebp} sizes={WIDE_SIZES} />
            <source type="image/avif" srcset={tallAvif} sizes={TALL_SIZES} />
            <source type="image/webp" srcset={tallWebp} sizes={TALL_SIZES} />
            <img
              src={fallback.src}
              width={heroTall.width}
              height={heroTall.height}
              alt={alt}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
          </picture>
        </figure>
      )
    }

    <p class="label eyebrow">Data analyst · Tashkent, Uzbekistan</p>
    <h1 class="claim">I build the data systems behind everyday decisions.</h1>

    <Staircase
      class="opening-chain"
      layers={{
        store: 'SQL Server · stored procedures',
        move: 'Python · pandas · ReportLab',
        read: 'Power BI · DAX · PDF reports',
        write: 'web platform · Telegram bot',
      }}
    />

    <p class="prose support">
      I&rsquo;m Nodir, the sole data analyst for a seven-branch family entertainment
      company. I take work from messy 1C data and SQL Server models through Power BI,
      Python automation, and internal tools used daily by around 20 people.
    </p>
  </section>

  {/* ---- Profile -------------------------------------------------------- */}
  <section id="profile">
    <h2 class="label">Profile</h2>
    <div class="prose stack-p">
      <p>
        I work comfortably on undefined operational problems: interviewing the people
        who have them, measuring what is going wrong, and shipping a system that makes
        the answer repeatable.
      </p>
      <p>
        My work spans the full chain from ERP extraction and dimensional modelling to
        dashboards, automated reports, and small applications built around how people
        actually work.
      </p>
    </div>
    <p class="more"><a href="/about/">More about me</a></p>
  </section>

  {/* ---- Experience ----------------------------------------------------- */}
  <section id="experience">
    <h2 class="label">Experience</h2>
    <article class="experience">
      <header class="experience-head">
        <div>
          <h3 class="title">Data Analyst · Pentazone</h3>
          <p class="summary">First and only data hire for seven branches across Uzbekistan.</p>
        </div>
        <p class="meta">Oct 2025 — Present</p>
      </header>
      <ul class="evidence prose">
        <li>Built the Power BI operations wall board used daily by the founder and department heads.</li>
        <li>Designed staging and dimensional layers over 1C ERP so reporting no longer depends on 1C internals.</li>
        <li>Analysed 1,327 maintenance requests and 747 audit comments, tracing 11 systemic failures to three root causes.</li>
        <li>Shipped a six-role operations platform with four-stage approvals for around 20 staff.</li>
      </ul>
    </article>
  </section>

  {/* ---- Selected work -------------------------------------------------- */}
  <section id="work">
    <h2 class="label">Work</h2>
    {/* The axis, named exactly once. A demonstration of the system rather than a
        description of it — the four words sit at the four stops they define, each
        with a two-or-three-word gloss so it reads as a legend and not as four
        stranded labels. Once, small, in Slate. Then never again. */}
    <Staircase gloss class="key" />

    <ol class="work">
      {
        projects.map((p) => (
          /* Titles sit at depth 0 so the index stays legible at a glance. The
             project-specific staircase carries the data-chain signal. */
          <li class="row">
            <h3 class="title"><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
            <p class="summary">{p.data.summary}</p>
            <Staircase layers={p.data.layers} />
          </li>
        ))
      }
    </ol>
  </section>

  {/* ---- Toolkit -------------------------------------------------------- */}
  <section id="toolkit">
    <h2 class="label">Toolkit</h2>
    <Staircase
      layers={{
        store: 'SQL Server · T-SQL · 1C ERP',
        move: 'Python · pandas · SQLAlchemy',
        read: 'Power BI · DAX · ReportLab',
        write: 'Next.js · React · Telegram',
      }}
    />
    <p class="prose after-chain">
      I use the smallest useful tool for the job: a semantic layer when definitions drift,
      a scheduled report when repetition is the problem, and an application when the
      workflow itself needs to change.
    </p>
  </section>
</Base>

<style>
  section { margin-top: var(--gap-section); }
  .opening { margin-top: 0; }
  section > .label { margin-bottom: 0.9rem; }

  .claim { margin-bottom: clamp(0.75rem, 2vw, 1.15rem); }
  .eyebrow { margin-bottom: 0.7rem; }
  .opening-chain { margin-bottom: clamp(0.85rem, 2vw, 1.15rem); }
  .support { margin-bottom: 0; }

  /* The key: quiet, once, then never again. It sits tight under the section
     label so it reads as the header of the list rather than as an orphaned
     first row with its content missing. */
  /* No opacity here: fading Slate would manufacture a sixth value and drop it
     below 4.5:1. Separation is done with space, which is free. */
  :global(.staircase.key) { margin-bottom: 2.25rem; }


  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .row .title { margin-bottom: 0.15rem; }
  .summary {
    font-size: var(--t-summary);
    color: var(--slate);
    max-width: min(var(--measure), 100%);
    margin-bottom: 0.5rem;
  }
  .meta {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.02em;
    color: var(--slate);
    margin: 0;
  }

  .after-chain { margin-top: 1.1rem; }
  .more {
    margin-top: 1.5rem;
    font-family: var(--mono);
    font-size: var(--t-meta);
  }
  .stack-p { display: flex; flex-direction: column; }
  .experience-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1rem;
  }
  .experience-head .summary { margin: 0; }
  .evidence {
    margin: 0;
    padding-inline-start: 1.2rem;
  }
  .evidence li + li { margin-top: 0.55rem; }
</style>
