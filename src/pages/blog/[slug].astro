---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, readingMinutes } = post.data;
const dateFmt = new Intl.DateTimeFormat('en-CA', { dateStyle: 'short' });
---

<Base title={`${title} — Nodir`} description={description} path={`/blog/${post.id}/`}>
  <article>
    <p class="label">Writing</p>
    <h1 class="claim post-title">{title}</h1>
    <p class="meta">
      {
        pubDate ? (
          <time datetime={pubDate.toISOString()}>{dateFmt.format(pubDate)}</time>
        ) : (
          <span class="todlir">[TO'LDIR — date]</span>
        )
      }
      {readingMinutes && <>{' · '}{readingMinutes} min</>}
    </p>

    <div class="prose body">
      <Content />
    </div>

    <p class="back"><a href="/blog/">All posts</a></p>
  </article>
</Base>

<style>
  .post-title {
    font-size: clamp(1.5rem, 1rem + 2.2vw, 1.875rem);
    margin-bottom: 0.5rem;
  }
  .meta {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.02em;
    color: var(--slate);
    margin-bottom: 2rem;
  }
  /* Slate, not Trace: Trace is 4.21:1 and declared non-text-only, so using it
     for text fails AA. Caught by Lighthouse, not by eye. */
  .todlir { color: var(--slate); }
  .body :global(h2) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--t-title);
    line-height: 1.3;
    margin: 2.25rem 0 0.6rem;
  }
  .body :global(p) { margin: 0 0 0.95rem; }
  .body :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--shelf);
    padding: 0.08em 0.3em;
    border-radius: 2px;
  }
  .body :global(pre) {
    background: var(--shelf);
    border-radius: 3px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .body :global(pre code) { background: none; padding: 0; }
  .back {
    margin-top: var(--gap-section);
    font-family: var(--mono);
    font-size: var(--t-meta);
  }
</style>
