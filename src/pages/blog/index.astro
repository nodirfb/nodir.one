---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

/* Explicitly ordered by frontmatter `order`, not by date and not by filename. */
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const dateFmt = new Intl.DateTimeFormat('en-CA', { dateStyle: 'short' });
---

<Base
  title="Writing — Nodir Fayzullayev"
  description="Notes on building and running data systems as a one-person team: SQL Server semantic layers, 1C extraction, and generated PDF reports."
  path="/blog/"
>
  <header class="intro">
    <p class="label">Writing</p>
    <h1 class="claim">Notes from building data systems in practice.</h1>
    <p class="prose lead">
      SQL Server, 1C extraction, Power BI, and the reporting decisions around them.
    </p>
  </header>
  {/* The month dot strip renders here at five posts or more. Below that the dates
      alone do the job, and a near-empty track would be a graphic whose actual
      content is "he rarely writes." */}
  <ol class="posts">
    {
      posts.map((post) => (
        <li>
          <h2 class="title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          <p class="summary">{post.data.description}</p>
          {
            (post.data.pubDate || post.data.readingMinutes) && (
              <p class="meta">
                {post.data.pubDate && (
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFmt.format(post.data.pubDate)}
                  </time>
                )}
                {post.data.pubDate && post.data.readingMinutes && <> · </>}
                {post.data.readingMinutes && <>{post.data.readingMinutes} min</>}
              </p>
            )
          }
        </li>
      ))
    }
  </ol>
  <p class="back"><a href="/">Home</a></p>
</Base>

<style>
  .posts {
    list-style: none;
    margin: var(--gap-section) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .title { margin-bottom: 0.15rem; }
  .summary {
    font-size: var(--t-summary);
    color: var(--slate);
    max-width: min(var(--measure), 100%);
    margin-bottom: 0.35rem;
  }
  .meta {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.02em;
    color: var(--slate);
    margin: 0;
  }
  .back {
    margin-top: var(--gap-section);
    font-family: var(--mono);
    font-size: var(--t-meta);
  }
  .intro .label { margin-bottom: 0.9rem; }
  .intro .claim { margin-bottom: 1.15rem; }
  .lead { font-size: var(--t-summary); }
</style>
